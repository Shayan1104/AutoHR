# AutoHR Backend Environment Variables
PROJECT_NAME="AutoHR API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security & JWT
SECRET_KEY="autohr-super-secret-jwt-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 18 Local)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=autohr_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/autohr_db
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/autohr_db

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# File Storage Configuration
UPLOAD_DIR="uploads"

# AI / LLM Configuration
OPENAI_API_KEY=""
AI_MODEL_NAME="gpt-4o"
